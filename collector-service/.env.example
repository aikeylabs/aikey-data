# PostgreSQL connection string (shared with aikey-control)
DATABASE_DSN=postgres://aikey:aikey@localhost:5432/aikey?sslmode=disable

# HTTP listen address
LISTEN_ADDR=0.0.0.0:27300

# Migrations directory
MIGRATIONS_DIR=./migrations

# Service token for proxy authentication
SERVICE_TOKEN=changeme

# Log level: debug, info, warn, error
AIKEY_LOG_LEVEL=info
