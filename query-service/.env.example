# PostgreSQL connection string (shared with aikey-control / collector-service)
DATABASE_DSN=postgres://aikey:aikey@localhost:5432/aikey?sslmode=disable

# HTTP listen address
LISTEN_ADDR=0.0.0.0:27310

# Service token for API authentication
SERVICE_TOKEN=changeme

# Log level: debug, info, warn, error
AIKEY_LOG_LEVEL=info
